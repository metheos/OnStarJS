# ---------------------------------------------------------------------------
# IMAP email MFA settings (required when GM presents email MFA)
# ---------------------------------------------------------------------------
# IMAP server hostname for your email provider.  Common values:
#   Gmail / Google Workspace : imap.gmail.com
#   Outlook / Hotmail / Live : outlook.office365.com
#   Yahoo Mail               : imap.mail.yahoo.com
#   Apple iCloud Mail        : imap.mail.me.com
#   FastMail                 : imap.fastmail.com
IMAP_SERVER=""

# IMAP-over-SSL port (default: 993)
# IMAP_PORT=993

# IMAP login username.  Defaults to ONSTAR_USERNAME if not set.
# IMAP_USERNAME=""

# Password for the IMAP account.
# For Gmail, create an App Password (myaccount.google.com/apppasswords).
# For Outlook, use your regular password or an app password if MFA is enabled.
IMAP_PASSWORD=""

# Subject matcher used to find the GM code email.
# You can set a plaintext prefix (legacy behavior) or /regex/flags.
# Default: /^Your (?:GM|Chevrolet|GMC|Buick|Cadillac) Verification Code:/i
# Example plaintext: IMAP_SUBJECT_PREFIX="Your Chevrolet Verification Code"
# Example regex: IMAP_SUBJECT_PREFIX="/^Your (?:Chevrolet|Cadillac) Verification Code:/i"
# IMAP_SUBJECT_PREFIX="/^Your (?:GM|Chevrolet|GMC|Buick|Cadillac) Verification Code:/i"

# From address used to find the GM code email (default shown below).
# IMAP_SENDER="GeneralMotors@em.gm.com"

# Mailbox/folder path to search.  Common values by provider:
#   Gmail / Outlook / iCloud / FastMail : INBOX
#   Yahoo Mail                          : Inbox
# IMAP_MAILBOX="INBOX"